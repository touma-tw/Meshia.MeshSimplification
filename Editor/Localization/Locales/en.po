msgid "Touma.MeshSimplification.MeshSimplifierOptions.PreserveBorderEdges.label"
msgstr "Preserve Border Edges"

msgid "Touma.MeshSimplification.MeshSimplifierOptions.PreserveBorderEdges.tooltip"
msgstr ""
"Avoid removing edges that do not touch other surfaces, such as holes or cross sections.\n"
"If you want to suppress hole generation during simplification, enable this option."

msgid "Touma.MeshSimplification.MeshSimplifierOptions.PreserveSurfaceCurvature.label"
msgstr "Preserve Surface Curvature"

msgid "Touma.MeshSimplification.MeshSimplifierOptions.PreserveSurfaceCurvature.tooltip"
msgstr "Use a process that preserves gently curved surfaces, but sometimes the results can be worse."

msgid "Touma.MeshSimplification.MeshSimplifierOptions.UseBarycentricCoordinateInterpolation.label"
msgstr "Use Barycentric Coordinate Interpolation"

msgid "Touma.MeshSimplification.MeshSimplifierOptions.UseBarycentricCoordinateInterpolation.tooltip"
msgstr ""
"Use Barycentric Coordinate Interpolation instead of linear interpolation for interpolating UVs, etc.\n"
"If you find that the texture is distorted, try toggling this option."

msgid "Touma.MeshSimplification.MeshSimplifierOptions.MinNormalDot.label"
msgstr "Tolerance for Normal Angle (by cosθ)"

msgid "Touma.MeshSimplification.MeshSimplifierOptions.MinNormalDot.tooltip"
msgstr ""
"Specifies how much normal misalignment to allow when generating lightweight polygons.\n"
"For example, 0(=cos90°) allows up to 90° misalignment, and -1(=cos180°) allows up to 180° misalignment."

msgid "Touma.MeshSimplification.MeshSimplifierOptions.EnableSmartLink.label"
msgstr "Enable Smart Link"

msgid "Touma.MeshSimplification.MeshSimplifierOptions.EnableSmartLink.tooltip"
msgstr "If this option is enabled, vertices that are not originally connected but are close to each other will be included in the first merge candidates. Increases the processing time."

msgid "Touma.MeshSimplification.MeshSimplifierOptions.SmartLinkOptions"
msgstr "Smart Link Options"

msgid "Touma.MeshSimplification.MeshSimplifierOptions.VertexLinkDistance.label"
msgstr "Vertex Link Distance"

msgid "Touma.MeshSimplification.MeshSimplifierOptions.VertexLinkDistance.tooltip"
msgstr ""
"This value is used to select candidates for merging vertices that are not originally connected to each other, based on their position proximity.\n"
"Larger values may increase processing time and crashes with meshes having more than 40,000 vertices."

msgid "Touma.MeshSimplification.MeshSimplifierOptions.VertexLinkColorDistance.label"
msgstr "Vertex Link Color Distance"

msgid "Touma.MeshSimplification.MeshSimplifierOptions.VertexLinkColorDistance.tooltip"
msgstr ""
"This value is used to select candidates for merging vertices that are not originally connected to each other, based on their vertex color similarity.\n"
"Larger values may improve the shape of the polygons after lightening, but sometimes result in unnatural vertex colors instead."

msgid "Touma.MeshSimplification.MeshSimplifierOptions.VertexLinkUvDistance.label"
msgstr "Vertex Link UV Distance"

msgid "Touma.MeshSimplification.MeshSimplifierOptions.VertexLinkUvDistance.tooltip"
msgstr ""
"This value is used to select candidates for merging vertices that are not originally connected to each other, based on their UV coordinate proximity.\n"
"Larger values may improve the shape of the polygons after lightening, but sometimes result in unnatural UVs instead."

msgid "Touma.MeshSimplification.MeshSimplifierOptions.VertexLinkMinNormalDot.label"
msgstr "Tolerance for Normal Angle (by cosθ)"

msgid "Touma.MeshSimplification.MeshSimplifierOptions.VertexLinkMinNormalDot.tooltip"
msgstr "Use different tolerance for normal angle for Smart Link. The stricter of the two is used for Smart Link."

msgid "Touma.MeshSimplification.MeshSimplifierOptions.PreserveSubMeshBoundaries.label"
msgstr "Preserve Material Boundaries"

msgid "Touma.MeshSimplification.MeshSimplifierOptions.PreserveSubMeshBoundaries.tooltip"
msgstr ""
"Prevents merging vertices that belong to different sub meshes (materials).\n"
"Keeps material boundaries crisp and avoids material bleeding when simplifying multi-material meshes such as avatars."

msgid "Touma.MeshSimplification.MeshSimplifierOptions.PreserveUVSeams.label"
msgstr "Preserve UV Seams"

msgid "Touma.MeshSimplification.MeshSimplifierOptions.PreserveUVSeams.tooltip"
msgstr ""
"Locks vertices that lie on a UV seam (coincident in position but discontinuous in UV).\n"
"Prevents textures from being torn apart across seams during simplification."

msgid "Touma.MeshSimplification.MeshSimplifierOptions.ConstrainOptimalPosition.label"
msgstr "Suppress Self-Intersection"

msgid "Touma.MeshSimplification.MeshSimplifierOptions.ConstrainOptimalPosition.tooltip"
msgstr ""
"Constrains the collapsed vertex to the neighborhood of the edge it came from.\n"
"Suppresses spikes that poke through other surfaces (self-intersection / clipping)."

msgid "Touma.MeshSimplification.MeshSimplifierOptions.MaxCollapseDisplacementFactor.label"
msgstr "Max Collapse Displacement Factor"

msgid "Touma.MeshSimplification.MeshSimplifierOptions.MaxCollapseDisplacementFactor.tooltip"
msgstr ""
"The optimal position is rejected when it is farther than this factor times the edge length from the edge midpoint.\n"
"Smaller values are stricter (less spiking) but may slightly reduce shape accuracy."

msgid "Touma.MeshSimplification.MeshSimplifierOptions.UseAttributeAwareError.label"
msgstr "Preserve Texture Mapping (Attribute-Aware Error)"

msgid "Touma.MeshSimplification.MeshSimplifierOptions.UseAttributeAwareError.tooltip"
msgstr ""
"Includes UV coordinates in the error metric itself (attribute-aware quadric error).\n"
"Greatly reduces texture distortion at high reduction ratios, at the cost of extra initialization time and memory."

msgid "Touma.MeshSimplification.MeshSimplifierOptions.UvErrorWeight.label"
msgstr "UV Error Weight"

msgid "Touma.MeshSimplification.MeshSimplifierOptions.UvErrorWeight.tooltip"
msgstr ""
"Relative importance of UV preservation versus geometric shape.\n"
"Larger values preserve the texture mapping more aggressively; smaller values favor geometric accuracy."

msgid "locale:en"
msgstr "English"
